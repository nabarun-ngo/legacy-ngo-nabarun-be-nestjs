  meetingDescription     String?
  meetingAgenda          String?
  meetingLocation        String?
  meetingStartTime       DateTime
  meetingEndTime         DateTime?
  meetingType            String?
  status                 String
  extVideoConferenceLink String?
  extHtmlLink            String?
  creatorEmail           String?
  createdById            String?
  meetingNotes           String?
  meetingTranscript      String?
